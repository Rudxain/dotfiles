#!/bin/sh
set -euf
IFS='
'

readonly usage='Usage: termux-brightness-2 brightness
Set the screen brightness between 0 and 8'

if [ $# -ne 1 ]; then
	echo "$usage"
	exit 0
fi

case "$1" in [0-8]);;
*)
	printf '%s\n' 'ERROR: Arg must be an integer between 0 and 8 !' "$usage"
	exit 1;;
esac

readonly b=$((~(-1 << $1)))

adb shell settings put system screen_brightness $b || \
# indirectly call `termux-api`,
# for forwards-compatibility
termux-brightness $b
