#!/bin/sh
set -euf
IFS='
'

if [ -n "${TERMUX_VERSION:-}" ]; then
	readonly dir=$HOME/downloads/hx
else
	readonly dir=$HOME/Downloads/hx
fi

# don't `git fetch` in any way (e.g. `clone`),
# I want to update manually and review changes before rebuild
if [ ! -d $dir ]; then
	echo 'repo not found' >&2
	exit 1
fi

cd $dir

# TO-DO: skip build if `hx -V` matches `HEAD`

export HELIX_DISABLE_AUTO_GRAMMAR_BUILD=1

# `--locked` to avoid supply-chain attacks, at the cost of unpatched vulns
if [ -n "${TERMUX_VERSION:-}" ]; then
	# TO-DO: `cargo fetch`, internet off, VPN off, await build, VPN on, internet on.
	# Why: because I use NetGuard, which is killed by LMKD.
	# Disabling VPN also frees RAM.
	# Ideally, also ensure child-proc restrictions are disabled.
	# https://consumerrights.wiki/index.php?title=Android&oldid=62706
	termux-wake-lock
	# `rustup` can't download binaries for Android,
	# because they don't (yet) exist
	cargo i --path helix-term --locked
	strip-stat ~/.cargo/bin/hx
	termux-wake-unlock
else
	# assume `rustup`-managed install
	cargo +nightly i --path helix-term --locked
fi

strip-stat $HOME/.cargo/bin/hx || :

# assume runtime is set

# assume `~/.config/helix/languages.toml` has `use-grammars.only`
hx -g fetch && hx -g build
# TO-DO: update when merged
# https://github.com/helix-editor/helix/pull/6633
