#!/bin/sh
set -euf
IFS='
'

readonly dir=$HOME/Downloads/hx

# don't `git fetch` in any way (e.g. `clone`),
# I want to update manually and review changes before rebuild
if [ ! -d $dir ]; then
	echo 'repo not found' >&2
	exit 1
fi

cd $dir

# TO-DO: skip build if `hx -V` matches `HEAD`

export HELIX_DISABLE_AUTO_GRAMMAR_BUILD=1

# assume `rustup`-managed install
cargo +nightly i --path helix-term \
	--locked # avoid supply-chain attacks, at the cost of unpatched vulns

strip-stat $HOME/.cargo/bin/hx || :

# assume runtime is set

# assume `~/.config/helix/languages.toml` has `use-grammars.only`
hx -g fetch && hx -g build
# TO-DO: update when merged
# https://github.com/helix-editor/helix/pull/6633
